---
interface Props { title?: string; description?: string; }
const {
  title = '森田太郎 | プロフィール・論文',
  description = '森田太郎のプロフィール、論文、ブログ。',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const blogActive = Astro.url.pathname.startsWith(`${base}/blog`);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <nav class="site-nav" aria-label="メインナビゲーション">
      <a href={`${base}/`} aria-current={!blogActive ? 'page' : undefined}>プロフィール</a>
      <a href={`${base}/blog/`} aria-current={blogActive ? 'page' : undefined}>ブログ</a>
    </nav>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
  .site-nav {
    display: flex; gap: 24px; box-sizing: border-box;
    width: min(100%, 808px); margin: 0 auto; padding: 24px 24px 0;
    font-family: "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif; font-size: 14px;
  }
  .site-nav a { color: #53615c; text-decoration: none; padding-bottom: 6px; }
  .site-nav a[aria-current] { color: #202a27; border-bottom: 2px solid #55746b; }
  .site-nav a:hover { color: #16836b; }
  :global(a:focus-visible) { outline: 2px solid #16836b; outline-offset: 4px; }
  @media (max-width: 600px) { .site-nav { padding-inline: 20px; } }
</style>
